# Template only: the .example extension keeps it out of "oc apply -f <dir>/".
# Prefer creating it directly (see README.md):
#   oc create secret generic mongo-portal-session -n <namespace> --from-literal=session-key="$(openssl rand -hex 32)"
apiVersion: v1
kind: Secret
metadata:
  name: mongo-portal-session
type: Opaque
stringData:
  # Random, at least 32 bytes, identical for all replicas.
  session-key: "REPLACE-with-output-of-openssl-rand-hex-32"

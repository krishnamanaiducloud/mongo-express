# Template only: the .example extension keeps it out of "oc apply -f <dir>/".
# Copy, replace every value, apply once, and never commit the real values:
#   cp secrets.yml.example /tmp/secrets.yml && vi /tmp/secrets.yml && oc apply -n <namespace> -f /tmp/secrets.yml && rm /tmp/secrets.yml
# Or create them directly (see README.md).
apiVersion: v1
kind: Secret
metadata:
  name: mongo-express-url
type: Opaque
stringData:
  # One shared MongoDB account for all mongo-express users: use a least-privilege user.
  ME_CONFIG_MONGODB_URL: "mongodb://REPLACE-user:REPLACE-password@REPLACE-mongodb-host-0:27017,REPLACE-mongodb-host-1:27017/?replicaSet=REPLACE-replica-set&authSource=admin"
  # Two different random values, e.g. openssl rand -hex 32
  ME_CONFIG_SITE_COOKIESECRET: "REPLACE-random-cookie-secret"
  ME_CONFIG_SITE_SESSIONSECRET: "REPLACE-different-random-session-secret"
---
apiVersion: v1
kind: Secret
metadata:
  name: mongo-express-basicauth
type: Opaque
stringData:
  # The local account: signs in when OpenShift login is unavailable (role ME_CONFIG_RBAC_LOCAL_ROLE).
  username: "REPLACE-ui-user"
  password: "REPLACE-strong-password"
